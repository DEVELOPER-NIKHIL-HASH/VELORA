import { useCallback, useEffect, useState, type FormEvent } from "react";
import "./SellerDashboard.css";

const API = "http://localhost:5000/api";

type Seller = {
  id: number;
  name: string;
  email: string;
};

type Store = {
  id: number;
  name: string;
  slug: string;
};

type Product = {
  id: number;
  name: string;
  description: string;
  price: number;
  stock: number;
  image_url: string;
  is_active: number;
};

type ProductForm = {
  name: string;
  description: string;
  price: string;
  stock: string;
  image_url: string;
  is_active: boolean;
};

const emptyForm: ProductForm = {
  name: "",
  description: "",
  price: "",
  stock: "0",
  image_url: "",
  is_active: true,
};

function money(value: number) {
  return new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    maximumFractionDigits: 2,
  }).format(value);
}

async function readResponse(response: Response) {
  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    if (response.status === 401) {
      throw new Error("Session expired. Please sign in again.");
    }
    throw new Error(data.message || "Request failed.");
  }

  return data;
}

export default function SellerDashboard() {
  const [token, setToken] = useState(
    () => sessionStorage.getItem("velora_seller_token") || ""
  );
  const [seller, setSeller] = useState<Seller | null>(null);
  const [store, setStore] = useState<Store | null>(null);
  const [products, setProducts] = useState<Product[]>([]);
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [search, setSearch] = useState("");
  const [showForm, setShowForm] = useState(false);
  const [editingId, setEditingId] = useState<number | null>(null);
  const [form, setForm] = useState<ProductForm>(emptyForm);

  const logout = useCallback(() => {
    sessionStorage.removeItem("velora_seller_token");
    setToken("");
    setSeller(null);
    setStore(null);
    setProducts([]);
    setPassword("");
    setError("");
    setNotice("");
  }, []);

  const loadProducts = useCallback(async (authToken: string) => {
    setLoading(true);
    setError("");

    try {
      const response = await fetch(`${API}/products`, {
        headers: { Authorization: `Bearer ${authToken}` },
      });
      const data = await readResponse(response);

      setProducts(data.products || []);
      setStore(data.store || null);

      const profileResponse = await fetch(`${API}/auth/me`, {
        headers: { Authorization: `Bearer ${authToken}` },
      });
      const profile = await readResponse(profileResponse);

      setSeller(profile.seller || null);
      if (!data.store && profile.stores?.[0]) {
        setStore(profile.stores[0]);
      }
    } catch (err) {
      const message =
        err instanceof Error ? err.message : "Could not load dashboard.";

      if (message.includes("Session expired")) {
        logout();
        setError("Your session expired. Please sign in again.");
      } else {
        setError(message);
      }
    } finally {
      setLoading(false);
    }
  }, [logout]);

  useEffect(() => {
    if (token) void loadProducts(token);
  }, [token, loadProducts]);

  async function login(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setSaving(true);
    setError("");
    setNotice("");

    try {
      const response = await fetch(`${API}/auth/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email.trim(), password }),
      });

      const data = await readResponse(response);

      if (!data.token) throw new Error("Login token missing.");

      sessionStorage.setItem("velora_seller_token", data.token);
      setSeller(data.seller || null);
      setToken(data.token);
      setPassword("");
      setNotice("Welcome to your VELORA seller workspace.");
    } catch (err) {
      setError(err instanceof Error ? err.message : "Login failed.");
    } finally {
      setSaving(false);
    }
  }

  function startAdd() {
    setEditingId(null);
    setForm(emptyForm);
    setError("");
    setNotice("");
    setShowForm(true);
  }

  function startEdit(product: Product) {
    setEditingId(product.id);
    setForm({
      name: product.name,
      description: product.description || "",
      price: String(product.price),
      stock: String(product.stock),
      image_url: product.image_url || "",
      is_active: Boolean(product.is_active),
    });
    setError("");
    setNotice("");
    setShowForm(true);
  }

  async function saveProduct(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (!token) return;

    const price = Number(form.price);
    const stock = Number(form.stock);

    if (!Number.isFinite(price) || price < 0) {
      setError("Price must be a valid non-negative amount.");
      return;
    }

    if (!Number.isSafeInteger(stock) || stock < 0) {
      setError("Stock must be a whole number of zero or more.");
      return;
    }

    setSaving(true);
    setError("");
    setNotice("");

    const body = {
      name: form.name.trim(),
      description: form.description,
      price,
      stock,
      image_url: form.image_url.trim(),
      is_active: form.is_active ? 1 : 0,
    };

    try {
      const response = await fetch(
        editingId === null
          ? `${API}/products`
          : `${API}/products/${editingId}`,
        {
          method: editingId === null ? "POST" : "PUT",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify(body),
        }
      );

      await readResponse(response);
      setNotice(
        editingId === null
          ? "Product added successfully."
          : "Product updated successfully."
      );
      setShowForm(false);
      setEditingId(null);
      setForm(emptyForm);
      await loadProducts(token);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Could not save product.");
    } finally {
      setSaving(false);
    }
  }

  async function deleteProduct(product: Product) {
    if (!token) return;
    if (!window.confirm(`Delete "${product.name}"? This cannot be undone.`)) {
      return;
    }

    setError("");
    setNotice("");

    try {
      const response = await fetch(`${API}/products/${product.id}`, {
        method: "DELETE",
        headers: { Authorization: `Bearer ${token}` },
      });
      await readResponse(response);

      setProducts((current) =>
        current.filter((item) => item.id !== product.id)
      );
      setNotice("Product deleted.");
    } catch (err) {
      setError(err instanceof Error ? err.message : "Could not delete product.");
    }
  }

  const filteredProducts = products.filter((product) =>
    `${product.name} ${product.description}`
      .toLowerCase()
      .includes(search.toLowerCase())
  );

  if (!token) {
    return (
      <main className="seller-login-page">
        <a className="seller-back-link" href="/">â† Back to storefront</a>
        <section className="seller-login-card">
          <div className="seller-mark">V</div>
          <p className="seller-eyebrow">VELORA COMMERCE</p>
          <h1>Welcome back.</h1>
          <p className="seller-subtitle">
            Your business, beautifully managed.
          </p>

          {error && <p className="seller-alert error" role="alert">{error}</p>}

          <form onSubmit={login} className="seller-form">
            <label htmlFor="seller-email">Email address</label>
            <input
              id="seller-email"
              type="email"
              autoComplete="username"
              required
              maxLength={254}
              value={email}
              onChange={(event) => setEmail(event.target.value)}
              placeholder="you@business.com"
            />

            <label htmlFor="seller-password">Password</label>
            <input
              id="seller-password"
              type="password"
              autoComplete="current-password"
              required
              value={password}
              onChange={(event) => setPassword(event.target.value)}
              placeholder="Enter your password"
            />

            <button className="seller-primary-button" disabled={saving}>
              {saving ? "Signing in..." : "Sign in to dashboard â†’"}
            </button>
          </form>

          <p className="seller-footnote">
            Secure seller access Â· Your store data stays in your account.
          </p>
        </section>
      </main>
    );
  }

  return (
    <main className="seller-page">
      <aside className="seller-sidebar">
        <a href="/" className="seller-logo">
          <span className="seller-mark small">V</span>
          <span>VELORA</span>
        </a>

        <p className="seller-nav-label">WORKSPACE</p>
        <a href="#overview" className="seller-nav-item active">â–¦ Overview</a>
        <a href="#inventory" className="seller-nav-item">â–¤ Products</a>
        <a href="/" className="seller-nav-item">â†— View storefront</a>

        <div className="seller-sidebar-bottom">
          <div className="seller-avatar">
            {(seller?.name || "S").charAt(0).toUpperCase()}
          </div>
          <div className="seller-account">
            <strong>{seller?.name || "Seller"}</strong>
            <span>{seller?.email || ""}</span>
          </div>
          <button className="seller-logout" onClick={logout} title="Sign out">
            â†ª
          </button>
        </div>
      </aside>

      <section className="seller-main" id="overview">
        <header className="seller-topbar">
          <div>
            <p className="seller-eyebrow">SELLER WORKSPACE</p>
            <h1>Good business starts here.</h1>
            <p className="seller-subtitle">
              Manage your products and inventory in one place.
            </p>
          </div>
          <button
            className="seller-secondary-button"
            onClick={() => void loadProducts(token)}
            disabled={loading}
          >
            â†» Refresh
          </button>
        </header>

        {store && (
          <div className="seller-store-banner">
            <div>
              <span className="seller-store-label">YOUR STORE</span>
              <h2>{store.name}</h2>
              <span className="seller-store-slug">/{store.slug}</span>
            </div>
            <span className="seller-store-status">â— Store connected</span>
          </div>
        )}

        {error && <p className="seller-alert error" role="alert">{error}</p>}
        {notice && <p className="seller-alert success" role="status">{notice}</p>}

        <div className="seller-stats">
          <article className="seller-stat">
            <span>Total products</span>
            <strong>{products.length}</strong>
            <small>In your inventory</small>
          </article>
          <article className="seller-stat">
            <span>Active products</span>
            <strong>{products.filter((p) => p.is_active).length}</strong>
            <small>Available listings</small>
          </article>
          <article className="seller-stat">
            <span>Units in stock</span>
            <strong>{products.reduce((sum, p) => sum + p.stock, 0).toLocaleString("en-IN")}</strong>
            <small>Across all products</small>
          </article>
          <article className="seller-stat">
            <span>Inventory value</span>
            <strong>{money(products.reduce((sum, p) => sum + p.price * p.stock, 0))}</strong>
            <small>Price Ã— stock</small>
          </article>
        </div>

        <section className="seller-inventory" id="inventory">
          <div className="seller-inventory-heading">
            <div>
              <p className="seller-eyebrow">CATALOG MANAGEMENT</p>
              <h2>Your products</h2>
              <p className="seller-subtitle">
                Create and maintain your store catalogue.
              </p>
            </div>
            <button className="seller-primary-button add-button" onClick={startAdd}>
              + Add product
            </button>
          </div>

          <div className="seller-toolbar">
            <input
              aria-label="Search products"
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Search products..."
            />
            <button
              className="seller-secondary-button"
              onClick={() => void loadProducts(token)}
              disabled={loading}
            >
              {loading ? "Loading..." : "Reload catalogue"}
            </button>
          </div>

          {loading ? (
            <div className="seller-empty">Loading your catalogue...</div>
          ) : filteredProducts.length === 0 ? (
            <div className="seller-empty">
              <span>â—‡</span>
              <h3>{search ? "No matching products" : "Your catalogue is waiting"}</h3>
              <p>{search ? "Try another search." : "Add your first product to get started."}</p>
            </div>
          ) : (
            <div className="seller-table-wrap">
              <table className="seller-table">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredProducts.map((product) => (
                    <tr key={product.id}>
                      <td>
                        <div className="seller-product-cell">
                          {product.image_url ? (
                            <img src={product.image_url} alt="" />
                          ) : (
                            <div className="seller-product-placeholder">V</div>
                          )}
                          <div>
                            <strong>{product.name}</strong>
                            <small>{product.description || "No description"}</small>
                          </div>
                        </div>
                      </td>
                      <td>{money(product.price)}</td>
                      <td>{product.stock}</td>
                      <td>
                        <span className={`seller-status ${product.is_active ? "live" : "inactive"}`}>
                          {product.is_active ? "Active" : "Draft"}
                        </span>
                      </td>
                      <td>
                        <div className="seller-actions">
                          <button onClick={() => startEdit(product)}>Edit</button>
                          <button className="delete" onClick={() => void deleteProduct(product)}>Delete</button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {showForm && (
          <div className="seller-modal-backdrop">
            <section
              className="seller-modal"
              role="dialog"
              aria-modal="true"
              aria-labelledby="seller-product-form-title"
            >
              <div className="seller-modal-heading">
                <div>
                  <p className="seller-eyebrow">PRODUCT CATALOGUE</p>
                  <h2 id="seller-product-form-title">
                    {editingId === null ? "Add a product" : "Edit product"}
                  </h2>
                </div>
                <button
                  className="seller-modal-close"
                  onClick={() => setShowForm(false)}
                  aria-label="Close form"
                >
                  Ã—
                </button>
              </div>

              <form onSubmit={saveProduct} className="seller-form">
                <label htmlFor="product-name">Product name *</label>
                <input
                  id="product-name"
                  required
                  maxLength={200}
                  value={form.name}
                  onChange={(event) => setForm({ ...form, name: event.target.value })}
                  placeholder="e.g. Premium Wireless Headphones"
                />

                <label htmlFor="product-description">Description</label>
                <textarea
                  id="product-description"
                  maxLength={5000}
                  rows={3}
                  value={form.description}
                  onChange={(event) => setForm({ ...form, description: event.target.value })}
                  placeholder="Describe your product..."
                />

                <div className="seller-form-grid">
                  <div>
                    <label htmlFor="product-price">Price (â‚¹) *</label>
                    <input
                      id="product-price"
                      required
                      type="number"
                      min="0"
                      step="0.01"
                      value={form.price}
                      onChange={(event) => setForm({ ...form, price: event.target.value })}
                    />
                  </div>
                  <div>
                    <label htmlFor="product-stock">Stock quantity *</label>
                    <input
                      id="product-stock"
                      required
                      type="number"
                      min="0"
                      step="1"
                      value={form.stock}
                      onChange={(event) => setForm({ ...form, stock: event.target.value })}
                    />
                  </div>
                </div>

                <label htmlFor="product-image">Image URL (optional)</label>
                <input
                  id="product-image"
                  type="url"
                  maxLength={2048}
                  value={form.image_url}
                  onChange={(event) => setForm({ ...form, image_url: event.target.value })}
                  placeholder="https://example.com/product.jpg"
                />

                <label className="seller-checkbox">
                  <input
                    type="checkbox"
                    checked={form.is_active}
                    onChange={(event) => setForm({ ...form, is_active: event.target.checked })}
                  />
                  Make product active
                </label>

                {error && <p className="seller-alert error" role="alert">{error}</p>}

                <div className="seller-modal-actions">
                  <button
                    type="button"
                    className="seller-secondary-button"
                    onClick={() => setShowForm(false)}
                    disabled={saving}
                  >
                    Cancel
                  </button>
                  <button className="seller-primary-button" disabled={saving}>
                    {saving ? "Saving..." : editingId === null ? "Save product" : "Update product"}
                  </button>
                </div>
              </form>
            </section>
          </div>
        )}
      </section>
    </main>
  );
}

